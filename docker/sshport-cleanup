#!/bin/sh
# 受限清理工具：只结束“确实监听指定端口”的允许进程。
# 用法：sshport-cleanup <port> <port_start> <port_end> <timeout> <process_name>...
# 退出码：0 已清理或本来无监听；3 无监听；2 参数错误；4 探测失败；5 拒绝清理。
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

if [ "$#" -lt 5 ]; then
    echo "usage: sshport-cleanup <port> <start> <end> <timeout> <process>..." >&2
    exit 2
fi

port=$1
range_start=$2
range_end=$3
timeout=$4
shift 4

case "$port" in
    ''|*[!0-9]*) echo "invalid port" >&2; exit 2 ;;
esac
case "$range_start" in
    ''|*[!0-9]*) echo "invalid range start" >&2; exit 2 ;;
esac
case "$range_end" in
    ''|*[!0-9]*) echo "invalid range end" >&2; exit 2 ;;
esac
case "$timeout" in
    ''|*[!0-9]*) echo "invalid timeout" >&2; exit 2 ;;
esac

if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ] \
    || [ "$range_start" -lt 1 ] || [ "$range_end" -gt 65535 ] \
    || [ "$range_start" -gt "$range_end" ] \
    || [ "$port" -lt "$range_start" ] || [ "$port" -gt "$range_end" ]; then
    echo "port outside configured range" >&2
    exit 2
fi
if [ "$timeout" -lt 1 ] || [ "$timeout" -gt 60 ]; then
    echo "timeout must be 1..60" >&2
    exit 2
fi

allowed_names=" "
for name in "$@"; do
    case "$name" in
        ''|*[!A-Za-z0-9._-]*)
            echo "invalid process name" >&2
            exit 2
            ;;
    esac
    allowed_names="$allowed_names$name "
done

is_allowed() {
    case "$allowed_names" in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

command -v ss >/dev/null 2>&1 || {
    echo "ss not available" >&2
    exit 4
}

listeners=$(ss -H -ltnp "sport = :$port" 2>/dev/null) || {
    echo "ss failed" >&2
    exit 4
}
if [ -z "$listeners" ]; then
    echo "port $port is not listening"
    exit 3
fi

pairs=$(printf '%s\n' "$listeners" \
    | grep -oE '\("[^"]+",pid=[0-9]+' \
    | sed -E 's/^\("([^"]+)",pid=([0-9]+)$/\1 \2/' \
    | sort -u) || true
if [ -z "$pairs" ]; then
    echo "listener on port $port has no visible pid" >&2
    exit 5
fi

pids=""
while read -r name pid; do
    [ -n "$pid" ] || continue
    if ! is_allowed "$name"; then
        echo "refusing to kill process $name pid $pid on port $port" >&2
        exit 5
    fi
    if [ ! -r "/proc/$pid/comm" ]; then
        echo "cannot verify pid $pid" >&2
        exit 5
    fi
    live_name=$(cat "/proc/$pid/comm")
    if ! is_allowed "$live_name"; then
        echo "refusing to kill changed process $live_name pid $pid" >&2
        exit 5
    fi
    pids="$pids $pid"
done <<EOF
$pairs
EOF

if [ -z "$pids" ]; then
    echo "no allowed listener on port $port" >&2
    exit 5
fi

for pid in $pids; do
    kill -TERM "$pid" 2>/dev/null || true
done

deadline=$(( $(date +%s) + timeout ))
while [ "$(date +%s)" -lt "$deadline" ]; do
    if ! ss -H -ltn "sport = :$port" 2>/dev/null | grep -q .; then
        echo "cleaned port $port pids=$(echo $pids)"
        exit 0
    fi
    sleep 1
done

# 宽限期后仍监听，仅对已确认的同名进程使用 SIGKILL。
for pid in $pids; do
    if [ -r "/proc/$pid/comm" ]; then
        live_name=$(cat "/proc/$pid/comm")
        if is_allowed "$live_name"; then
            kill -KILL "$pid" 2>/dev/null || true
        fi
    fi
done
sleep 1

if ss -H -ltn "sport = :$port" 2>/dev/null | grep -q .; then
    echo "port $port is still listening after cleanup" >&2
    exit 5
fi

echo "cleaned port $port pids=$(echo $pids)"
exit 0
